# Copy this file to .env.local and replace every placeholder locally.
# Never commit .env.local or paste its contents into chat.
CFA_TESTGEN_INTERNAL_TOKEN=replace-with-random-local-token
CFA_TESTGEN_OPEN_PR_URL=http://127.0.0.1:8080/internal/testgen/open-pr

# Spring classifier/EvalRunner (only if using cloud profile)
LLM_PROFILE=cloud
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=replace-with-openrouter-key
LLM_MODEL=replace-with-model-id

# GitHub App values, if running webhook/worker locally
GITHUB_APP_ID=replace-with-app-id
GITHUB_APP_PRIVATE_KEY_PATH=C:/path/to/private-key.pem
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret
